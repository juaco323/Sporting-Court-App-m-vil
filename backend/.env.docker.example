# ==========================================
# Configuración de variables de entorno para Docker
# ==========================================
# Este archivo es una plantilla. Copia este archivo a .env.docker
# y ajusta los valores según tu entorno de producción.

# ==========================================
# Backend Configuration
# ==========================================

# Base de datos SQLite (ruta dentro del contenedor)
DATABASE_URL=sqlite:///./db_data/sporting_court.db

# Clave secreta para JWT (CAMBIAR EN PRODUCCIÓN)
# Genera una nueva con: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# Algoritmo de encriptación JWT
ALGORITHM=HS256

# Tiempo de expiración del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# CORS Configuration
# ==========================================

# Orígenes permitidos para CORS (separados por coma)
# En producción, especifica el dominio exacto de tu frontend
CORS_ORIGINS=http://localhost,http://localhost:80,http://frontend:80

# ==========================================
# OpenWeather API
# ==========================================

# API Key para OpenWeather (si se usa)
OPENWEATHER_API_KEY=61f6915417ca53ccd95fb615cc7fb019

# ==========================================
# Server Configuration
# ==========================================

# Puerto del backend (dentro del contenedor)
BACKEND_PORT=8000

# Puerto del frontend (dentro del contenedor - Nginx)
FRONTEND_PORT=80

# ==========================================
# Database Configuration
# ==========================================

# Ruta de persistencia de la base de datos en el host
# Esta será montada como volumen en Docker
DB_VOLUME_PATH=./backend/db_data

# ==========================================
# Application Settings
# ==========================================

# Modo de ejecución (development/production)
ENVIRONMENT=production

# Nivel de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==========================================
# Security Settings
# ==========================================

# Habilitar HTTPS en producción
# ENABLE_HTTPS=true

# Dominio de la aplicación (para cookies seguras)
# APP_DOMAIN=tu-dominio.com
